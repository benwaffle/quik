<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/emoji_thumbs_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="👍"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/emoji_thumbs_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="👎"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/emoji_laugh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="😂"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/emoji_surprised"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="😮"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/emoji_sad"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="😢"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/emoji_angry"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="😠"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/emoji_heart"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="❤️"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/emoji_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="➕"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Full emoji picker (initially hidden, shown when More is tapped) -->
    <androidx.emoji2.emojipicker.EmojiPickerView
        android:id="@+id/emoji_picker_full"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:visibility="gone" />

</LinearLayout>
